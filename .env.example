# Copy this file to backend\.env and replace the fictitious values locally.
# Never store real credentials in this example file or in frontend files.

# Local database (default)
DATABASE_URL=sqlite:///./mindside.db
# PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mindside

# Replace with a long random value before using outside local development.
SECRET_KEY=replace-with-a-long-random-secret

# Select gemini, anthropic, or none.
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=FAKE_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# Local frontend origins; provide trusted origins, comma-separated, for deployment.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
